<Window x:Class="CamStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cam Studio"
        Width="900"
        Height="600">

	<Grid Margin="30">

		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Área de preview -->
		<Border
            Background="Black"
            CornerRadius="10">

			<TextBlock
                Text="CAM STUDIO"
                Foreground="White"
                FontSize="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

		</Border>
		<Image
    x:Name="VideoPreview"
    Width="640"
    Height="360"
    Stretch="Uniform"
    Margin="0,20,0,0"/>

		<!-- Panel de conexión -->
		<StackPanel
            Grid.Row="1"
            Margin="0,20,0,0">

			<StackPanel Orientation="Horizontal">

				<StackPanel Width="300">
					<TextBlock
                        Text="IP del celular"
                        FontSize="14"
                        Margin="0,0,0,5"/>

					<TextBox
                        x:Name="IpTextBox"
                        Text="192.168.100.203"
                        Height="35"
                        Padding="8"/>
				</StackPanel>

				<StackPanel Width="120"
                            Margin="15,0,0,0">

					<TextBlock
                        Text="Puerto"
                        FontSize="14"
                        Margin="0,0,0,5"/>

					<TextBox
                        x:Name="PortTextBox"
                        Text="5000"
                        Height="35"
                        Padding="8"/>
				</StackPanel>

				<Button
                    x:Name="ConnectButton"
                    Content="Conectar"
                    Width="120"
                    Height="35"
                    Margin="15,22,0,0"
                    Click="ConnectButton_Click"/>

			</StackPanel>

			<TextBlock
                x:Name="StatusText"
                Text="🟠 Desconectado"
                FontSize="18"
                Margin="0,15,0,0"/>

			<TextBlock
                x:Name="ClientText"
                Text="Celular: -"
                FontSize="14"
                Margin="0,5,0,0"/>

		</StackPanel>

	</Grid>

</Window>